#--------------------------------------------------------------------
# SIDAK TEJO ENTERPRISE EDITION v3.0.0
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
#
# IMPORTANT:
# - Copy this file to `.env` on your production server.
# - Do NOT put spaces around '=' (e.g., KEY=value).
# - Fill in your actual production database credentials.
# - NEVER commit your live `.env` file to version control.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# 1. RUNTIME ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT=production

#--------------------------------------------------------------------
# 2. APPLICATION CONFIGURATION
#--------------------------------------------------------------------
app.baseURL=https://sidaktejo.site/
app.forceGlobalSecureRequests=false
app.CSPEnabled=false

#--------------------------------------------------------------------
# 3. PRODUCTION DATABASE CONFIGURATION (Fill with live credentials)
#--------------------------------------------------------------------
database.default.hostname=localhost
database.default.database=u532206332_sidaktejo
database.default.username=u532206332_sidaktejo
database.default.password=YOUR_PRODUCTION_DB_PASSWORD_HERE
database.default.DBDriver=MySQLi
database.default.DBPrefix=
database.default.charset=utf8mb4
database.default.DBCollat=utf8mb4_general_ci
database.default.port=3306

#--------------------------------------------------------------------
# 4. SECURITY & COOKIES (Production-Safe Defaults)
#--------------------------------------------------------------------
security.csrfProtection=cookie
security.tokenName=csrf_test_name
security.headerName=X-CSRF-TOKEN
security.cookieName=csrf_cookie_name
security.expires=7200
security.regenerate=false
security.redirect=true

#--------------------------------------------------------------------
# 5. LOGGING (Threshold 4: Error & Critical Only for Production)
#--------------------------------------------------------------------
logger.threshold=4
